+/// split so `"zipp: …"`/`"RangeError: …"` are told apart correctly.
+fn is_error_name(name: &str) -> bool {
+    !name.is_empty()
+        && name.ends_with("Error")
+        && name.chars().all(|c| c.is_ascii_alphanumeric() || c == '_' || c == '$')
